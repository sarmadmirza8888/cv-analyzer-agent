# Copy to .env (never commit .env). On Kaggle, use Kaggle secrets for the two Databricks values.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
MLFLOW_EXPERIMENT=/Users/<your-email>/my-ai-agent

# Needed outside Kaggle (on Kaggle they are auto-detected under /kaggle/input)
CV_AGENT_MODEL_PATH=/path/to/mistral-7b-instruct-4bit
CV_AGENT_DATA_DIR=/path/to/cv-json-files
CV_AGENT_HISTORY_PATH=./history.json
